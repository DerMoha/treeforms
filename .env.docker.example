# Copy to .env.docker and set strong values before running Docker Compose.
APP_PORT=3000

MARIADB_DATABASE=treeforms
MARIADB_USER=treeforms
MARIADB_PASSWORD=change-this-db-password
MARIADB_ROOT_PASSWORD=change-this-root-password

DEFAULT_WORKSPACE_ID=workspace_demo
DEFAULT_WORKSPACE_NAME=Demo Workspace
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-plus-char-secret
