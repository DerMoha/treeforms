# Optional for MySQL-backed app storage.
# APP_DATABASE_URL=mysql://user:password@localhost:3306/treeforms_app

# Optional. Falls back to APP_DATABASE_URL if set.
# SUBMISSION_DATABASE_URL=mysql://user:password@localhost:3306/treeforms_submissions

# Optional. Used when APP_DATABASE_URL is not set.
# LOCAL_SQLITE_PATH=.data/treeforms-local.sqlite
# LOCAL_SQLITE_DISABLED=1

DEFAULT_WORKSPACE_ID=workspace_demo
DEFAULT_WORKSPACE_NAME=Demo Workspace
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-plus-char-secret
ADMIN_LOGIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-32-plus-char-session-secret
# Optional; defaults shown below.
# ADMIN_SESSION_TTL_SECONDS=28800
# RESPONDENT_SESSION_TTL_SECONDS=86400
# PUBLIC_API_CORS_ORIGINS=https://example.com,https://app.example.com
# DB_TARGET_TEST_ALLOWED_HOSTS=db.example.com,.dbs.example.net
# DB_TARGET_TEST_ALLOW_PRIVATE=0
